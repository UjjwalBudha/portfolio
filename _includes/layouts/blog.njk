<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{{ title }}</title>
    <meta content="{{ description }}" name="description">
    <meta content="{{ keywords | join(', ') }}" name="keywords">
    <meta name="author" content="{{ site.author }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ site.url }}{{ page.url | cleanUrl }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ site.url }}{{ page.url | cleanUrl }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="{{ site.url }}/blogs/{{ heroImage }}">
    <meta property="og:site_name" content="Ujwal Budha Portfolio">
    <meta property="article:published_time" content="{{ date | isoDate }}">
    <meta property="article:modified_time" content="{{ date | isoDate }}">
    <meta property="article:author" content="{{ site.author }}">
    <meta property="article:section" content="{{ articleSection }}">
    {%- for tag in articleTags %}
    <meta property="article:tag" content="{{ tag }}">
    {%- endfor %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ site.url }}{{ page.url | cleanUrl }}">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ site.url }}/blogs/{{ heroImage }}">
    <meta name="twitter:creator" content="{{ site.authorTwitter }}">

    <link href="../assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="../assets/css/blog.css" rel="stylesheet">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{ site.gaId }}');
    </script>

    <!-- JSON-LD Structured Data: BlogPosting -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "{{ title }}",
      "description": "{{ description }}",
      "image": "{{ site.url }}/blogs/{{ heroImage }}",
      "datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ date | isoDate }}",
      "author": {
        "@type": "Person",
        "name": "{{ site.author }}",
        "url": "{{ site.url }}",
        "jobTitle": "DevOps Engineer"
      },
      "publisher": {
        "@type": "Person",
        "name": "{{ site.author }}",
        "url": "{{ site.url }}"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url | cleanUrl }}"
      },
      "keywords": [{% for k in keywords %}"{{ k }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      "articleSection": "{{ articleSection }}",
      "inLanguage": "en-US"
    }
    </script>

    {%- if howTo %}
    <!-- JSON-LD Structured Data: HowTo -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "{{ title }}",
      "description": "{{ description }}",
      "totalTime": "{{ howTo.totalTime }}",
      "step": [
        {%- for step in howTo.steps %}
        {
          "@type": "HowToStep",
          "name": "{{ step.name }}",
          "text": "{{ step.text }}"
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    </script>
    {%- endif %}

    {%- if faq %}
    <!-- JSON-LD Structured Data: FAQPage -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in faq %}
        {
          "@type": "Question",
          "name": "{{ item.q }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ item.a }}"
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    </script>
    {%- endif %}

    <!-- Shared Navigation Bar -->
    <script src="../assets/js/navbar.js"></script>
</head>

<body>
    <!-- Blog Header -->
    <header>
        <div class="banner">
            <div class="content">
                <h1>{{ title }}</h1>
                <p class="blog-date">{{ dateDisplay }}</p>
            </div>
        </div>
    </header>

    <!-- Blog Content -->
    <main>
        {{ content | safe }}

        {%- if relatedPosts %}
        <section class="related-posts">
            <h2>Related Articles</h2>
            <div style="display: grid; gap: 20px;">
                {%- for post in relatedPosts %}
                <a href="{{ post.href }}" class="post-link">
                    <h4>{{ post.title }}</h4>
                    <p>{{ post.excerpt }}</p>
                </a>
                {%- endfor %}
            </div>
        </section>
        {%- endif %}

        <section class="author-section">
            <h3>Written By</h3>
            <p class="author-name">{{ site.author }}</p>
            <p class="author-date">Published: {{ dateDisplay }}</p>
            <p class="author-bio">
                Hello, I am Ujwal Budha. Currently working as a DevOps Engineer.
                Expert in creating scalable cloud infrastructure and automating the workflow for deployment. An AWS
                Certified Solution Architect Associate, Ujwal enjoys sharing knowledge in the form of technical blogs
                and helping others to go through their cloud journey.
            </p>
        </section>
    </main>

    <script src="../assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>
